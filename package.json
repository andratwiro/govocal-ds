{
  "name": "govocal-ds",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./base": "./src/base.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "prestorybook": "node scripts/token-usage.mjs",
    "tokens:pull": "node scripts/figma-pull.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:rename": "node scripts/rename-tokens.mjs",
    "tokens:usage": "node scripts/token-usage.mjs",
    "icons:in-use": "node scripts/icons-in-use.mjs",
    "components:index": "node scripts/component-index.mjs",
    "figma:spec": "node scripts/figma-spec.mjs",
    "prebuild:storybook": "node scripts/token-usage.mjs",
    "build:storybook": "storybook build -o dist/storybook --quiet",
    "build:backoffice": "vite build --config backoffice/vite.config.ts",
    "build:site": "node scripts/assemble-site.mjs",
    "build": "npm run build:storybook && npm run build:backoffice && npm run build:site",
    "a11y:scan": "node scripts/a11y-scan.mjs",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "pretypecheck": "node scripts/token-usage.mjs",
    "typecheck": "tsc --noEmit",
    "api:imports": "node scripts/use-public-api.mjs backoffice/src",
    "css:scope": "node scripts/scope-base-css.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "maplibre-gl": "6.16.0",
    "react": "18.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "10.6",
    "@storybook/addon-mcp": "10.6",
    "@storybook/react-vite": "10.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "storybook": "10.6",
    "storybook-design-token": "^5.0.0",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
